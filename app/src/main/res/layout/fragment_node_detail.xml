<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/nodeDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сервер"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Температура CPU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Температура CPU"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/cpuTempValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 °C"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Температура корпуса -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Температура корпуса"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/caseTempValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 °C"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Влажность -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Влажность"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/humidityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 %"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ток -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ток"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/currentValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 А"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Напряжение -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Напряжение"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/voltageValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 В"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Вентилятор -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Вентилятор"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/fanRpmValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 об/мин"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Время последнего замера -->
        <TextView
            android:id="@+id/receivedAtText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:textStyle="italic" />

    </LinearLayout>
</ScrollView>
